# Copy to a private env file; do not commit the populated file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./nebula.db
SECURE_COOKIES=false
REDIS_URL=redis://redis:6379/0
REFRESH_DAYS=14
AI_PROVIDER=mock
# Required only for Compose; generate a private password (URL-safe characters).
POSTGRES_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD
# Compose is DEVELOPMENT ONLY. Production needs HTTPS, secure cookies,
# production environment, real reviewed question imports and hardening.
